# Copie para ".env" e preencha. O arquivo .env nunca deve ser enviado ao GitHub.

# Senha do banco PostgreSQL (escolha uma forte).
DB_PASSWORD=

# Texto longo e aleatório (mínimo 32 caracteres) que protege a chave da IA guardada no banco.
# Gere um com:  openssl rand -base64 48
# ATENÇÃO: se perder este valor, a chave da IA gravada no banco não poderá mais ser lida (basta cadastrá-la de novo).
CHATJR_SECRET=

# "true" (padrão) exige HTTPS, exceto em localhost. Use "false" só se for publicar sem HTTPS.
CHATJR_COOKIE_SECURE=true

# Opcional: valor inicial da chave da IA. Depois do primeiro acesso ela é gerida pela tela de administração.
ANTHROPIC_API_KEY=

# Opcional: porta publicada no servidor.
PORT=8080
